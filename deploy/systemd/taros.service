[Unit]
Description=TarOS - Lightweight Linux system monitor
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=taros
Group=taros
# /opt/taros, not /usr/local/bin: this directory is owned by User= above
# (scripts/install.sh) so the in-app self-update feature can replace this
# binary in place without root — see docs/09-deployment.md §9.5. A symlink
# at /usr/local/bin/taros still exists for normal CLI use.
ExecStart=/opt/taros/taros --config /etc/taros/config.yaml
# always, not on-failure: the in-app self-update feature (internal/selfupdate,
# docs/09-deployment.md §9.5) replaces the binary then exits cleanly (code 0)
# on purpose, relying on this to bring it back up running the new build —
# on-failure would only restart on a crash/non-zero exit, not a clean one.
Restart=always
RestartSec=5

# Hardening dasar — lihat docs/09-deployment.md §9.3 kenapa
# ProtectHome/ProtectSystem sengaja tidak diperketat (fitur file explorer
# butuh akses baca/tulis luas ke filesystem sesuai konfigurasi rootDir).
NoNewPrivileges=true
ProtectHome=false
ProtectSystem=false

[Install]
WantedBy=multi-user.target
