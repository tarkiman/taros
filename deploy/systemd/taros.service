[Unit]
Description=TarOS - Lightweight Linux system monitor
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=taros
Group=taros
ExecStart=/usr/local/bin/taros --config /etc/taros/config.yaml
Restart=on-failure
RestartSec=5

# Hardening dasar — lihat docs/09-deployment.md §9.3 kenapa
# ProtectHome/ProtectSystem sengaja tidak diperketat (fitur file explorer
# butuh akses baca/tulis luas ke filesystem sesuai konfigurasi rootDir).
NoNewPrivileges=true
ProtectHome=false
ProtectSystem=false

[Install]
WantedBy=multi-user.target
